# Copy to .env locally; .env is ignored by Git and never copied into dist.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
HOST=127.0.0.1
PORT=4173
# Required to unlock AI, including localhost (>=24 characters for non-loopback Node).
# Enter this app access key in the website. Never put the DeepSeek key there.
APP_ACCESS_TOKEN=
# Explicit frontend origins when using a separate backend (comma separated).
ALLOWED_ORIGINS=https://minnerlee.github.io
